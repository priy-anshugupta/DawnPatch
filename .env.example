PORT=4310
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:1b
# Set temporal to use a running local Temporal service + npm run worker.
WORKFLOW_ENGINE=local
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=dawnpatch
SENTRY_DSN=
SERPAPI_API_KEY=
# Explicit directories containing repositories you authorize DawnPatch to copy/read.
# Separate Windows paths with semicolons. Leave blank to allow only the bundled fixture.
SOURCE_ROOTS=
# No repository installation/start commands run outside Docker isolation.
RUNNER_IMAGE=node:22-bookworm
GITHUB_TOKEN=
