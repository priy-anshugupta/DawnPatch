{
  "name": "dawnpatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "worker": "tsx server/temporal/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "temporal:dev": "node scripts/temporal.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared tests scripts *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@mastra/core": "1.79.0",
    "@sentry/node": "11.8.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "diff": "9.0.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
